# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files — high risk for accidental secret exposure
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Ansible
*.retry
ansible/playbooks/*.log

# Ansible Vault password file — never commit this
.vault_pass
.vault_password
vault_pass.txt

# AWS credentials and environment files — use ~/.aws/credentials instead
.env
.envrc
*.pem
*.key
aws_credentials
credentials
*_credentials

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Check Point OVA images — too large for Git
*.ova
*.iso

# detect-secrets — baseline is committed, but never the audit log
.secrets.audit
